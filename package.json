{
  "name": "seen-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:db": "supabase test db",
    "typecheck": "next typegen && tsc --noEmit",
    "db:setup-notify": "tsx --env-file=.env.local scripts/setup-local-notify.ts",
    "db:import-library": "tsx --env-file=.env.local scripts/import-library.ts",
    "test:e2e": "E2E_START_SERVER=1 playwright test",
    "test:e2e:dev": "E2E_BASE_URL=${E2E_BASE_URL:-http://localhost:3001} playwright test"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@serwist/next": "^9.5.13",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "next": "16.4.0",
    "nodemailer": "^10.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.2",
    "serwist": "^9.5.13",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
